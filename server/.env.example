# ==============================================================================
# BACKEND API (FASTAPI) ENVIRONMENT VARIABLES (.env.example)
# Copy this file to .env and fill in your actual configuration values
# ==============================================================================

# Database Settings (MongoDB)
MONGO_URL=mongodb://localhost:27017
DB_NAME=webdoanvat

# Environment & CORS Settings
IS_PROD=False
SAMESITE=lax
FRONTEND_URL=http://localhost:3000
FRONTEND_CLIENT_URL=http://localhost:3000
FRONTEND_ADMIN_URL=http://localhost:3001
SUPER_SECRET_SESSION_KEY=a-very-secret-session-key

# JWT & Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_ALGORITHM=HS256
SESSION_SECRET=your_session_secret_change_in_production

# Google OAuth2
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
CALLBACK_URL=http://localhost:8000/api/auth/google/callback

# Mail Service (Gmail SMTP)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_specific_password
MAIL_FROM=your_email@gmail.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# VietQR / Bank Transfer Configuration
BANK_BIN=970415
ACCOUNT_NO=0123456789
ACCOUNT_NAME=Nguyen Van A

# VNPay Payment Gateway
VNP_TMNCODE=your_vnp_tmncode
VNP_HASH_SECRET=your_vnp_hash_secret
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:3000/payment-result
VNP_IPN_URL=http://localhost:8000/api/payment/vnpay_ipn
VNP_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNP_ENV=sandbox

# Upstash Redis
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token
